{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TC227/linuxcnc-universal-atc/blob/main/schemas/atc-config.schema.json",
  "title": "LinuxCNC Universal ATC Configuration",
  "description": "Versioned hardware-independent ATC configuration shared by the eight-page GUI wizard and offline validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_id",
    "machine",
    "hardware",
    "atc"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "config_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linuxcnc_version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "linuxcnc_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "atc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "magazine",
        "transfer",
        "tool_management",
        "io_mapping",
        "spindle_orientation"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "disabled_signals": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        },
        "magazine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "pocket_count",
            "drive",
            "position_feedback"
          ],
          "properties": {
            "type": {
              "enum": [
                "umbrella",
                "rotary_disc",
                "side_mounted",
                "chain",
                "linear_rack"
              ]
            },
            "pocket_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "reference_pocket": {
              "type": "integer",
              "minimum": 1
            },
            "numbering_direction": {
              "enum": [
                "cw",
                "ccw",
                "forward",
                "reverse",
                "positive",
                "negative"
              ]
            },
            "direction_policy": {
              "enum": [
                "one_way",
                "shortest_path"
              ]
            },
            "reversible": {
              "type": "boolean"
            },
            "linear_pitch_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "side_mount_motion": {
              "enum": [
                "rotary",
                "chain"
              ]
            },
            "disc_layout": {
              "enum": [
                "horizontal",
                "vertical"
              ]
            },
            "drive": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "interface"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "dc_motor",
                    "stepper",
                    "servo",
                    "external"
                  ]
                },
                "interface": {
                  "enum": [
                    "digital_io",
                    "stepgen",
                    "fieldbus",
                    "external_controller"
                  ]
                }
              }
            },
            "position_feedback": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method"
              ],
              "properties": {
                "method": {
                  "enum": [
                    "gray_code",
                    "binary_code",
                    "bcd",
                    "home_index",
                    "per_pocket",
                    "incremental_encoder",
                    "absolute_encoder",
                    "drive_in_position",
                    "open_loop_step_count"
                  ]
                },
                "encoder_resource_id": {
                  "type": "string"
                },
                "index_offset": {
                  "type": "integer"
                },
                "bit_order": {
                  "enum": [
                    "lsb_first",
                    "msb_first"
                  ]
                },
                "has_valid_strobe": {
                  "type": "boolean"
                },
                "stable_sample_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5000
                }
              }
            }
          }
        },
        "transfer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mechanism"
          ],
          "properties": {
            "mechanism": {
              "enum": [
                "direct_pickup",
                "pot_movement",
                "single_arm",
                "double_arm_180"
              ]
            },
            "presentation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "fixed",
                    "pot_lift",
                    "pot_swing",
                    "pot_slide",
                    "magazine_retract",
                    "profile_defined"
                  ]
                }
              }
            },
            "drawbar": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "pneumatic",
                    "hydraulic",
                    "electric",
                    "external"
                  ]
                },
                "verification_method": {
                  "enum": [
                    "sensor",
                    "approved_alternative",
                    "not_configured"
                  ]
                },
                "require_air_pressure": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "tool_management": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "location_model"
          ],
          "properties": {
            "location_model": {
              "enum": [
                "fixed",
                "random"
              ]
            }
          }
        },
        "io_mapping": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource_id",
              "active_level"
            ],
            "properties": {
              "resource_id": {
                "type": "string",
                "minLength": 1
              },
              "active_level": {
                "enum": [
                  "high",
                  "low"
                ]
              }
            }
          }
        },
        "motion_resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "magazine_motion": {
              "type": "string"
            },
            "magazine_position_encoder": {
              "type": "string"
            },
            "spindle_encoder": {
              "type": "string"
            },
            "spindle_communication": {
              "type": "string"
            },
            "spindle_position_command": {
              "type": "string"
            }
          }
        },
        "spindle_orientation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend",
            "command_interface",
            "target_mode"
          ],
          "properties": {
            "backend": {
              "enum": [
                "servo_native_fixed",
                "servo_native_fieldbus",
                "linuxcnc_encoder_pid",
                "external_controller"
              ]
            },
            "command_interface": {
              "enum": [
                "digital_io_fixed_angle",
                "preset_select",
                "fieldbus_register",
                "linuxcnc_m19",
                "pulse_direction",
                "analog_position",
                "serial_command"
              ]
            },
            "target_mode": {
              "enum": [
                "fixed",
                "preset",
                "variable"
              ]
            },
            "fixed_angle_deg": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360
            },
            "orientation_offset_deg": {
              "type": "number",
              "minimum": -360,
              "maximum": 360
            },
            "direction_policy": {
              "enum": [
                "shortest",
                "cw",
                "ccw"
              ]
            },
            "tolerance_deg": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 180
            },
            "settling_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60000
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600000
            },
            "require_zero_speed": {
              "type": "boolean"
            },
            "require_brake_feedback": {
              "type": "boolean"
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "encoder_resource_id": {
                  "type": "string"
                },
                "communication_resource_id": {
                  "type": "string"
                },
                "position_command_resource_id": {
                  "type": "string"
                }
              }
            }
          }
        },
        "timeouts_ms": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600000
          }
        },
        "sequence_options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "require_spindle_stop": {
              "type": "boolean"
            },
            "require_m19": {
              "type": "boolean"
            },
            "require_air_pressure": {
              "type": "boolean"
            },
            "require_tool_present": {
              "type": "boolean"
            },
            "use_atc_door": {
              "type": "boolean"
            },
            "max_retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "modified_at": {
          "type": "string",
          "format": "date-time"
        },
        "application_version": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
